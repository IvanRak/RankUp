<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:RankUp.Models"
             x:Class="RankUp.Views.ProfilePage"
             BackgroundColor="#0a0e1a"
             Title="Профиль игрока">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Выйти" Clicked="OnLogoutClicked"/>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Padding="14" RowSpacing="10">

        <!-- ПРОФИЛЬ -->
        <Border Grid.Row="0" StrokeThickness="1.5" Stroke="#f5df67" Padding="16,12">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18"/>
            </Border.StrokeShape>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1e2840" Offset="0.0"/>
                    <GradientStop Color="#0f1420" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Shadow>
                <Shadow Brush="#f5df67" Offset="0,0" Radius="15" Opacity="0.25"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Grid.Column="0"
                        Stroke="#f5df67" StrokeThickness="2.5"
                        WidthRequest="72" HeightRequest="72">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="36"/>
                    </Border.StrokeShape>
                    <Image x:Name="AvatarImage" Aspect="AspectFill"/>
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                    <Label x:Name="NameLabel" FontSize="20" FontAttributes="Bold" TextColor="#f5df67"/>
                    <Label x:Name="SteamIdLabel" FontSize="10" TextColor="#8899aa"/>

                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Start" Margin="0,4,0,0">
                        <Image x:Name="RankMedal"
                               WidthRequest="36" HeightRequest="36"
                               Aspect="AspectFit"
                               VerticalOptions="Center"/>

                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Border StrokeThickness="1" Stroke="#f5df67"
                                    Padding="8,3" HorizontalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Label x:Name="RankLabel" FontSize="11"
                                       FontAttributes="Bold" TextColor="#f5df67"/>
                            </Border>
                            <Label x:Name="RankProgressLabel"
                                   FontSize="9"
                                   TextColor="#8899aa"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- СТАТИСТИКА -->
        <Border Grid.Row="1" StrokeThickness="1" Stroke="#2a3748" Padding="12,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14"/>
            </Border.StrokeShape>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1a2030" Offset="0.0"/>
                    <GradientStop Color="#0f1420" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="*,*,*">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="ПОБЕДЫ" FontSize="9" TextColor="#4ade80"
                           HorizontalTextAlignment="Center" CharacterSpacing="1"/>
                    <Label x:Name="WinsLabel" FontSize="28" FontAttributes="Bold"
                           TextColor="#4ade80" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="ПОРАЖЕНИЯ" FontSize="9" TextColor="#f87171"
                           HorizontalTextAlignment="Center" CharacterSpacing="1"/>
                    <Label x:Name="LossesLabel" FontSize="28" FontAttributes="Bold"
                           TextColor="#f87171" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" Spacing="2">
                    <Label Text="WINRATE" FontSize="9" TextColor="#f5df67"
                           HorizontalTextAlignment="Center" CharacterSpacing="1"/>
                    <Label x:Name="WinRateLabel" FontSize="28" FontAttributes="Bold"
                           TextColor="#f5df67" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- ЧИПЫ -->
        <ScrollView Grid.Row="2" Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never" Margin="0,2">
            <HorizontalStackLayout Spacing="6">

                <Border x:Name="FilterAllChip" Padding="14,6" StrokeThickness="1.5"
                        Stroke="#f5df67" BackgroundColor="#f5df67">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFilterAll"/>
                    </Border.GestureRecognizers>
                    <Label x:Name="FilterAllText" Text="ВСЕ" FontSize="12"
                           FontAttributes="Bold" TextColor="#0a0e1a"/>
                </Border>

                <Border x:Name="FilterWinChip" Padding="14,6" StrokeThickness="1.5"
                        Stroke="#4ade80" BackgroundColor="Transparent">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFilterWin"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6">
                        <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                 Color="#4ade80" VerticalOptions="Center"/>
                        <Label x:Name="FilterWinText" Text="0" FontSize="12"
                               FontAttributes="Bold" TextColor="#4ade80"/>
                    </HorizontalStackLayout>
                </Border>

                <Border x:Name="FilterLossChip" Padding="14,6" StrokeThickness="1.5"
                        Stroke="#f87171" BackgroundColor="Transparent">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFilterLoss"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6">
                        <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                 Color="#f87171" VerticalOptions="Center"/>
                        <Label x:Name="FilterLossText" Text="0" FontSize="12"
                               FontAttributes="Bold" TextColor="#f87171"/>
                    </HorizontalStackLayout>
                </Border>

                <Border x:Name="FilterFavChip" Padding="14,6" StrokeThickness="1.5"
                        Stroke="#f5df67" BackgroundColor="Transparent">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFilterFav"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="★" FontSize="14" TextColor="#f5df67" VerticalOptions="Center"/>
                        <Label x:Name="FilterFavText" Text="0" FontSize="12"
                               FontAttributes="Bold" TextColor="#f5df67"/>
                    </HorizontalStackLayout>
                </Border>

            </HorizontalStackLayout>
        </ScrollView>

        <!-- СЕРИЯ + СЕГОДНЯ -->
        <Border Grid.Row="3" StrokeThickness="1" Stroke="#2a3748" Padding="12,8">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1a2030" Offset="0.0"/>
                    <GradientStop Color="#0f1420" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="*,*,*">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="СЕРИЯ" FontSize="8" TextColor="#8899aa"
                           HorizontalTextAlignment="Center" CharacterSpacing="1"/>
                    <Label x:Name="StreakLabel" FontSize="18" FontAttributes="Bold"
                           TextColor="#4ade80" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="СЕГОДНЯ" FontSize="8" TextColor="#8899aa"
                           HorizontalTextAlignment="Center" CharacterSpacing="1"/>
                    <Label x:Name="TodayLabel" FontSize="18" FontAttributes="Bold"
                           TextColor="#f5df67" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" Spacing="2">
                    <Label Text="WR СЕГОДНЯ" FontSize="8" TextColor="#8899aa"
                           HorizontalTextAlignment="Center" CharacterSpacing="1"/>
                    <Label x:Name="TodayWrLabel" FontSize="18" FontAttributes="Bold"
                           TextColor="#4ade80" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- ВКЛАДКИ + PICKER -->
        <Grid Grid.Row="4" ColumnDefinitions="*,*,Auto" ColumnSpacing="8" Margin="0,2">

            <Border x:Name="TabMatchesChip" Grid.Column="0"
                    Padding="12,8" StrokeThickness="2"
                    Stroke="#f5df67" BackgroundColor="#f5df67">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTabMatches"/>
                </Border.GestureRecognizers>
                <Label x:Name="TabMatchesText" Text="МАТЧИ"
                       FontSize="13" FontAttributes="Bold"
                       TextColor="#0a0e1a" HorizontalTextAlignment="Center"
                       CharacterSpacing="1.5"/>
            </Border>

            <!-- 👇 ИСПРАВЛЕНО: #9f0000 → #c084fc -->
            <Border x:Name="TabFriendsChip" Grid.Column="1"
                    Padding="12,8" StrokeThickness="1.5"
                    Stroke="#c084fc" BackgroundColor="Transparent">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTabFriends"/>
                </Border.GestureRecognizers>
                <Label x:Name="TabFriendsText" Text="ДРУЗЬЯ"
                       FontSize="13" FontAttributes="Bold"
                       TextColor="#c084fc" HorizontalTextAlignment="Center"
                       CharacterSpacing="1.5"/>
            </Border>

            <Border x:Name="HeroPickerButton" Grid.Column="2"
                    StrokeThickness="1.5" Stroke="#f5df67"
                    Padding="10,8" WidthRequest="140">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1a2030" Offset="0.0"/>
                        <GradientStop Color="#0f1420" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHeroPickerClicked"/>
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                    <Label x:Name="HeroPickerLabel"
                           Grid.Column="0"
                           Text="Все герои"
                           FontSize="12" FontAttributes="Bold"
                           TextColor="#f5df67"
                           VerticalOptions="Center"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"/>
                    <Label Grid.Column="1"
                           Text="▾"
                           FontSize="14"
                           TextColor="#f5df67"
                           VerticalOptions="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- КОНТЕНТ -->
        <Grid Grid.Row="5">

            <!-- МАТЧИ -->
            <CollectionView x:Name="MatchesList"
                            SelectionMode="None"
                            RemainingItemsThreshold="5"
                            RemainingItemsThresholdReached="OnNearBottom">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:DotaMatch">
                        <Border Style="{StaticResource MatchCard}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMatchTapped"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="5,62,*,Auto,36" ColumnSpacing="10"
                                  Padding="0">
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#161c2c" Offset="0.0"/>
                                        <GradientStop Color="#0d121f" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Grid.Background>

                                <BoxView Grid.Column="0" WidthRequest="5"
                                         Color="{Binding IsWin, Converter={StaticResource WinColor}}"
                                         VerticalOptions="Fill"/>

                                <Border Grid.Column="1"
                                        Stroke="#f5df67" StrokeThickness="1.5"
                                        WidthRequest="62" HeightRequest="38"
                                        Margin="10,8,0,8"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8"/>
                                    </Border.StrokeShape>
                                    <Image Source="{Binding HeroIcon}" Aspect="AspectFill"/>
                                </Border>

                                <VerticalStackLayout Grid.Column="2" Spacing="3"
                                                     VerticalOptions="Center"
                                                     Padding="0,8">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="{Binding Result}"
                                               FontSize="11" FontAttributes="Bold"
                                               TextColor="{Binding IsWin, Converter={StaticResource WinColor}}"
                                               CharacterSpacing="1"/>
                                        <Border StrokeThickness="1" Stroke="#4a5568"
                                                Padding="5,1"
                                                IsVisible="{Binding MyPosition, Converter={StaticResource IntToBool}}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="4"/>
                                            </Border.StrokeShape>
                                            <Label Text="{Binding PositionLabel}"
                                                   FontSize="9" FontAttributes="Bold"
                                                   TextColor="#8899aa"/>
                                        </Border>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding Kda}"
                                           FontSize="15"
                                           TextColor="White"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="3" Spacing="3"
                                                     VerticalOptions="Center"
                                                     Padding="0,8">
                                    <Label Text="{Binding DateLabel}"
                                           FontSize="11" TextColor="#c9d1d9"
                                           HorizontalTextAlignment="End"/>
                                    <Label Text="{Binding DurationLabel}"
                                           FontSize="10" TextColor="#8899aa"
                                           HorizontalTextAlignment="End"/>
                                </VerticalStackLayout>

                                <Button Grid.Column="4"
                                        Text="{Binding IsFavorite, Converter={StaticResource FavIcon}}"
                                        FontSize="18"
                                        BackgroundColor="Transparent"
                                        Padding="0"
                                        WidthRequest="36" HeightRequest="36"
                                        VerticalOptions="Center"
                                        Clicked="OnToggleFavorite"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- ДРУЗЬЯ -->
            <ScrollView x:Name="FriendsPanel" IsVisible="False">
                <VerticalStackLayout Spacing="8" Padding="0,2">

                    <VerticalStackLayout x:Name="NoTeammatesView"
                                         Spacing="12"
                                         IsVisible="False"
                                         Margin="0,60,0,0">
                        <Label Text="🎮"
                               FontSize="48"
                               HorizontalTextAlignment="Center"
                               Opacity="0.4"/>
                        <Label Text="Пока никого"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#4a5568"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="Тиммейты появятся после загрузки матчей"
                               FontSize="12"
                               TextColor="#3a4558"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="TeammatesListVertical" Spacing="6"/>

                </VerticalStackLayout>
            </ScrollView>

        </Grid>

        <ActivityIndicator x:Name="Loader" Grid.Row="5"
                           IsRunning="False" Color="#f5df67"
                           HorizontalOptions="End"
                           VerticalOptions="End"
                           Margin="0,0,14,20"/>

        <!-- ОВЕРЛЕЙ ВЫБОРА ГЕРОЯ -->
        <Grid x:Name="HeroOverlay"
              Grid.RowSpan="6"
              IsVisible="False"
              BackgroundColor="#cc000000"
              ZIndex="100">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnHeroOverlayTapped"/>
            </Grid.GestureRecognizers>

            <Border StrokeThickness="1.5" Stroke="#f5df67"
                    Margin="30,100,30,100"
                    Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18"/>
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1e2840" Offset="0.0"/>
                        <GradientStop Color="#0f1420" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="16,14">
                        <Label Grid.Column="0"
                               Text="Выбор героя"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="#f5df67"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="✕"
                               FontSize="18"
                               TextColor="#f87171"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnHeroOverlayTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <Border Grid.Row="1"
                            Stroke="#2a3748" StrokeThickness="1"
                            Margin="16,0,16,10"
                            Padding="10,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Entry x:Name="HeroSearchEntry"
                               Placeholder="Поиск героя..."
                               PlaceholderColor="#4a5568"
                               TextColor="White"
                               BackgroundColor="Transparent"
                               FontSize="14"
                               HeightRequest="44"
                               TextChanged="OnHeroSearchChanged"/>
                    </Border>

                    <CollectionView x:Name="HeroList"
                                    Grid.Row="2"
                                    SelectionMode="Single"
                                    SelectionChanged="OnHeroSelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:HeroPickerItem">
                                <Grid Padding="16,8"
                                      ColumnDefinitions="48,*"
                                      ColumnSpacing="12">

                                    <Border Grid.Column="0"
                                            Stroke="#4a5568" StrokeThickness="1"
                                            WidthRequest="48" HeightRequest="28"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="5"/>
                                        </Border.StrokeShape>
                                        <Image Source="{Binding IconUrl}"
                                               Aspect="AspectFill"/>
                                    </Border>

                                    <Label Grid.Column="1"
                                           Text="{Binding Name}"
                                           FontSize="14"
                                           TextColor="White"
                                           VerticalOptions="Center"
                                           LineBreakMode="TailTruncation"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</ContentPage>